# Base URL of the Flask API.
#
# 보통은 **비워둡니다.**
#   - dev:  Vite 프록시가 /api·/static 을 http://localhost:8000 으로 전달
#   - 배포: Cloudflare Pages 의 public/_worker.js 가 같은 역할을 수행
# 두 경우 모두 same-origin 이라 CORS 설정도 크로스사이트 쿠키 설정도 필요 없습니다.
#
# 프록시를 쓰지 않고 백엔드 도메인을 직접 호출해야 할 때만 지정하세요.
# 그 경우 백엔드에 CORS_ORIGINS 등록 + SESSION_COOKIE_SAMESITE=None 이 필요합니다.
#   VITE_API_BASE=https://api.example.com
VITE_API_BASE=
